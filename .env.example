# Copy this file to .env and fill in the values. Never commit .env.
# Find both values in the Supabase dashboard: Project Settings -> API.

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The public anon / publishable key. Never put a service-role key here:
# anything prefixed VITE_ is bundled into the browser.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
